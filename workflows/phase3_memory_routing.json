        "message": "={{\n`<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #222;\">\n  <h2 style=\"margin-bottom: 12px; color: #b00020;\">AI Exception Summary - ALERT</h2>\n\n  <p><strong>Total rows reviewed:</strong> ${$json.total_exception_count}</p>\n  <p><strong>New exceptions:</strong> ${$json.new_exception_count}</p>\n  <p><strong>Known exceptions:</strong> ${$json.known_exception_count}</p>\n  <p><strong>Recommended action:</strong> ${$json.agent_action}</p>\n\n  <h3 style=\"margin-top: 24px; margin-bottom: 8px;\">AI Summary</h3>\n  <p style=\"line-height: 1.6;\">${String($json.text).replace(/\\\\n/g, '<br>')}</p>\n\n  <h3 style=\"margin-top: 24px; margin-bottom: 8px;\">Exception Details</h3>\n  <table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif; font-size: 12px;\">\n    <thead style=\"background-color: #f2f2f2;\">\n      <tr>\n        <th>Order ID</th>\n        <th>Order Date</th>\n        <th>Country</th>\n        <th>Product Type</th>\n        <th>Selling Price</th>\n        <th>Total Cost</th>\n        <th>Margin Value</th>\n        <th>Margin %</th>\n        <th>Delay Days</th>\n        <th>Priority</th>\n        <th>Status</th>\n        <th>Is New</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${$json.exceptions.map(e => `\n        <tr>\n          <td>${e.order_id}</td>\n          <td>${e.order_date}</td>\n          <td>${e.country}</td>\n          <td>${e.product_type}</td>\n          <td>${e.selling_price}</td>\n          <td>${e.total_cost}</td>\n          <td>${e.margin_value}</td>\n          <td>${e.margin_pct}</td>\n          <td>${e.delay_days}</td>\n          <td>${e.priority_level}</td>\n          <td>${e.status}</td>\n          <td>${e.is_new_exception}</td>\n        </tr>\n      `).join('')}\n    </tbody>\n  </table>\n</div>`\n}}",
